# =============================================================================
# Sportyra-News Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Application will not start without these
# -----------------------------------------------------------------------------

# PostgreSQL connection string (include credentials, host, port, database)
# Example: postgresql://user:password@host:5432/sportyra
DATABASE_URL=

# Secret for HMAC hashing of IP addresses in fraud detection (min 32 chars)
# Generate with: openssl rand -base64 32
FRAUD_IP_HMAC_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION FEATURES
# -----------------------------------------------------------------------------

# Admin bearer token for /admin CRUD endpoints
# Generate with: openssl rand -base64 32
SPORTYRA_ADMIN_TOKEN=

# CORS allowed origins (comma-separated)
# Example: https://sportyra.example.com,https://admin.sportyra.example.com
CORS_ORIGIN=

# Public site URL (used for emails, RSS, sitemap, password reset links)
# Example: https://sportyra.example.com
PUBLIC_SITE_URL=

# Google Cloud Storage private object directory
# Format: gs://bucket-name/path/to/private
PRIVATE_OBJECT_DIR=

# Google Cloud Storage public object search paths (comma-separated)
# Format: gs://bucket-name/path/to/public1,gs://bucket-name/path/to/public2
PUBLIC_OBJECT_SEARCH_PATHS=

# -----------------------------------------------------------------------------
# OPTIONAL - Application Configuration
# -----------------------------------------------------------------------------

# Server port (default: 3000)
PORT=3000

# Environment (production, development, test)
NODE_ENV=production

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OPTIONAL - Email (Resend) - Required for password reset emails in production
# -----------------------------------------------------------------------------

# Resend API key (get from https://resend.com)
RESEND_API_KEY=

# Sender email address (must be verified in Resend)
EMAIL_FROM=Sportyra News <noreply@sportyra.example.com>

# -----------------------------------------------------------------------------
# OPTIONAL - Push Notifications (VAPID) - Required for web push notifications
# -----------------------------------------------------------------------------

# VAPID private key (generate with: npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=

# VAPID contact email (used in VAPID JWT)
VAPID_EMAIL=admin@sportyra.example.com

# Frontend VAPID public key (exposed to client)
VITE_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - Error Monitoring (Sentry) - Required for production error tracking
# -----------------------------------------------------------------------------

# Sentry DSN (get from https://sentry.io)
VITE_SENTRY_DSN=

# Sentry environment (production, staging, development)
VITE_SENTRY_ENVIRONMENT=production

# App version for Sentry releases
VITE_APP_VERSION=

# -----------------------------------------------------------------------------
# OPTIONAL - Fraud Detection Alerting (Slack / PagerDuty)
# -----------------------------------------------------------------------------

# Slack incoming webhook URL for fraud alerts (T0-T2)
FRAUD_SLACK_WEBHOOK_URL=

# PagerDuty events routing key for T0 fraud alerts
FRAUD_PAGERDUTY_ROUTING_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - Frontend API Configuration
# -----------------------------------------------------------------------------

# API base URL for production frontend (default: same origin)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# OPTIONAL - Google AdSense (for ad placements)
# -----------------------------------------------------------------------------

# Master switch: set to "true" to enable Google AdSense delivery ("false"/blank disables)
VITE_ADS_ENABLED=false

# AdSense client ID (ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT=

# AdSense ad slot IDs for each placement
VITE_ADSENSE_HOME_SLOT=
VITE_ADSENSE_ARTICLE_SLOT=

# -----------------------------------------------------------------------------
# OPTIONAL - Sports Data Integration (if using external sports API)
# -----------------------------------------------------------------------------

# Sports image API key
SPORTS_IMAGE_API_KEY=

# Sports image API URL
SPORTS_IMAGE_API_URL=

# Sportmonks Football API key (get from https://www.sportmonks.com) - server-only, never expose to client
SPORTMONKS_API_KEY=

# Sportmonks Football API base URL (defaults to https://api.sportmonks.com/v3/football)
SPORTMONKS_BASE_URL=

# -----------------------------------------------------------------------------
# OPTIONAL - Google Cloud Storage (for image uploads)
# -----------------------------------------------------------------------------

# GCP project ID (if using standard GCP auth instead of Replit sidecar)
GCP_PROJECT_ID=

# GCP service account credentials (JSON string, base64 encoded, if using standard auth)
GCP_SERVICE_ACCOUNT_JSON=

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# 1. Database: PostgreSQL 15+ with UUID extension
#    Run migrations: pnpm --filter @workspace/db push
#
# 2. External Services Required:
#    - PostgreSQL 15+ database
#    - Resend account (for password reset emails)
#    - Google Cloud Storage bucket (for image uploads)
#    - VAPID keys for push notifications (generate with: npx web-push generate-vapid-keys)
#
# 3. Build Commands:
#    # Build all packages
#    pnpm run build
#
#    # Or build individually:
#    pnpm --filter @workspace/api-server build
#    pnpm --filter @workspace/sportyra build
#
# 4. Start Commands:
#    # API Server (runs on PORT, default 3000)
#    pnpm --filter @workspace/api-server start
#
#    # Frontend is served by API server from artifacts/sportyra/dist/public
#    # No separate frontend server needed in production
#
# 5. Health Check:
#    GET /api/healthz -> {"status":"ok","database":"ok",...}
#
# 6. Reverse Proxy (nginx/Apache) Configuration:
#    - Terminate TLS
#    - Proxy /api/* to http://localhost:3000
#    - Serve static files from artifacts/sportyra/dist/public
#    - Set X-Forwarded-Proto header for CSP/HSTS
#
# 7. Google Cloud Storage Setup:
#    - Create bucket for images
#    - Set PRIVATE_OBJECT_DIR=gs://bucket-name/private
#    - Set PUBLIC_OBJECT_SEARCH_PATHS=gs://bucket-name/public
#    - Configure IAM for service account with Storage Object Admin
#
# 8. VAPID Keys Generation:
#    npx web-push generate-vapid-keys
#    Set VAPID_PRIVATE_KEY, VAPID_EMAIL
#    Set VITE_VAPID_PUBLIC_KEY in frontend build
#
# 9. Resend Setup:
#    - Create account at resend.com
#    - Verify domain
#    - Create API key
#    - Set RESEND_API_KEY and EMAIL_FROM
#
# =============================================================================